{
  "expo": {
    "name": "Wayykup",
    "slug": "wayykup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wayykup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Wayykup uses photo access to recognize the target object in your Object Hunt wake-up challenge. Images are processed on-device and are not uploaded.",
        "NSMicrophoneUsageDescription": "Wayykup listens while you say your selected wake-up phrase. Audio is processed in memory on your device and never saved or uploaded.",
        "NSSpeechRecognitionUsageDescription": "Wayykup uses on-device speech recognition to verify your selected wake-up phrase."
      },
      "buildNumber": "18"
    },
    "android": {
      "package": "com.wayykup.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#111217",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": true,
          "microphonePermission": "Wayykup listens while you say your selected wake-up phrase. Audio is processed on-device and is not saved or uploaded."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wayykup uses the camera to recognize your selected object or verify push-up form. Images are processed on-device and are not uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      "expo-background-task",
      "expo-font",
      "expo-sharing",
      "./modules/wayykup-alarm/app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 37
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71ea7dcb-99e7-42cc-80e2-94cafcb93fe6"
      }
    },
    "owner": "vabery2",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71ea7dcb-99e7-42cc-80e2-94cafcb93fe6"
    }
  }
}
